{
  "mappings": [
    "wallet: Wallet balance=balance earned=earned spent=spent cashedOut=cashedOut groups=groups exchanges=exchanges transactions=cashouts",
    "group: ModelEarning name=name documents=documents earnings=earnings",
    "exchange: CreditExchange date=date cost=cost fee=fee documents=documents savings=savings",
    "transaction: Cashout date=date amount=amount"
  ],
  "imports": ["SeerKit"],
  "look": [
    "title = Font.brandTitle",
    "heading = Font.brandBody2",
    "body = Font.brandBody",
    "note = Font.brandNote",
    "note2 = Font.brandNote2",
    "accent = Color.accent",
    "gutter = CGFloat.layer7"
  ],
  "strings": [
    "title = Wallet",
    "amount = %.4f cr",
    "balance.eyebrow = CREDIT BALANCE",
    "earnings.eyebrow = EARNINGS",
    "available = {amount} available",
    "earned = Earned",
    "spent = Spent",
    "cashedOut = Cashed Out",
    "groups.title = Model Groups",
    "group.documents = {count} documents",
    "group.documents.one = {count} document",
    "exchanges.title = Credit Exchanges",
    "exchanges.seeAll = See All",
    "exchanges.empty = No inference exchanges yet",
    "exchange.title = Inference",
    "exchange.fee = fee {amount}",
    "transactions.title = Transactions",
    "transaction.title = Cashout",
    "transaction.amount = + {amount}",
    "loading = Loading wallet…",
    "allExchanges.title = All Exchanges",
    "allExchanges.eyebrow = TOTAL EXCHANGES",
    "allExchanges.count = {count} exchanges",
    "allExchanges.count.one = {count} exchange",
    "exchange.eyebrow = COST",
    "exchange.documents = Documents",
    "exchange.serviceFee = Service Fee",
    "exchange.total = Total Cost",
    "exchange.savings = Savings",
    "exchange.saved = -{amount}"
  ],
  "tuning": [
    "eyebrowTracking = 2.5",
    "eyebrowSize = 10",
    "balanceSize = 34",
    "unitSize = 14",
    "earningsSize = 22",
    "availableSize = 12",
    "availableSymbolSize = 11",
    "amountSize = 15",
    "feeSize = 11",
    "seeAllSize = 13",
    "groupCard = 150x120",
    "exchangeCard = 145x130",
    "cardOpacity = 0.45",
    "cardBorder = 0.07",
    "availableSymbol = arrow.up.circle.fill",
    "design = serif",
    "material = regular",
    "amountAnimation = .easeOut(duration: 0.4)"
  ],
  "launch": ["wallet = wallet", "wallet.exchanges = exchanges", "wallet.withdraw = withdraw"],
  "withdraw": "soon"
}
